# ---------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
#
#   PowerShell:   copy .env.example .env
#
# .env is listed in .gitignore and must NEVER be committed.
# This file (.env.example) IS committed — it documents what
# variables exist, using placeholders only.
# ---------------------------------------------------------------

# From @BotFather in Telegram. Format: <bot_id>:<secret>
# Treat this exactly like a password — anyone holding it controls the bot.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your personal chat id with the bot.
# Find it: message the bot, then open in a browser:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and read result[0].message.chat.id
TELEGRAM_CHAT_ID=1234567890

# How many hours back to look for new articles.
LOOKBACK_HOURS=24

# Max items shown with full summaries. The rest go in the
# "Also today" block as bare titles.
MAX_SUMMARY_ITEMS=8

# Max items taken from any single source, so one noisy feed
# cannot fill the entire digest.
MAX_PER_SOURCE=3

# ---------------------------------------------------------------
# Not needed yet — only for the optional LLM summarization step.
# Leave blank until then.
# ---------------------------------------------------------------
GROQ_API_KEY=
